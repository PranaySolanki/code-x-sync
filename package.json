{
  "name": "code-x-sync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "concurrently \"npm:next-start\" \"npm:build:landing-css\"",
    "next-start": "next start",
    "lint": "eslint",
    "build:landing-css": "npx tailwindcss --postcss -i ./src/screen/LandingPage/css/tailwind.css -o ./src/screen/LandingPage/css/tailwind-runtime.css -w"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.57.2",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "gsap": "^3.13.0",
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sass": "^1.92.1",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13"
  }
}
